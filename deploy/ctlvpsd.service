[Unit]
Description=ctlvps control plane (ctlvpsd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ctlvps
Group=ctlvps
WorkingDirectory=/opt/ctlvps
EnvironmentFile=/etc/ctlvps/ctlvpsd.env
ExecStart=/opt/ctlvps/ctlvpsd
Restart=always
RestartSec=3
LimitNOFILE=65536
MemoryMax=512M
Environment=GOMEMLIMIT=400MiB

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ctlvps/data
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=128
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
